generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  apifyApiKey  String?
  maxLeads     Int           @default(100)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobs         ScrapingJob[]

  @@map("users")
}

model ScrapingJob {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nombre editable de la base (por defecto: "Niche · Zone")
  name       String?
  /// Iniciales para el avatar de la card (2 chars)
  icon       String?  @default("NP")
  /// Color hex del avatar
  color      String?  @default("#7c3aed")
  niche      String
  zone       String
  status     String   @default("pending") // pending | running | done | error
  leadsFound Int      @default(0)
  apifyRunId String?
  error      String?
  leads      Lead[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("scraping_jobs")
}

model Lead {
  id           Int          @id @default(autoincrement())
  userId       String
  jobId        Int
  job          ScrapingJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  phone        String?
  rating       Float?
  reviewsCount Int?
  category     String?
  address      String?
  city         String?
  website      String?
  mapsUrl      String?
  searchNiche  String?
  searchZone   String?
  countryCode  String?
  createdAt    DateTime     @default(now())

  @@map("leads")
}
