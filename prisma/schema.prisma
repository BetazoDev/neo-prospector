// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id           Int      @id @default(autoincrement())
  title        String
  phone        String?
  rating       Float?
  reviewsCount Int?
  category     String?
  address      String?
  city         String?
  website      String?
  mapsUrl      String?
  searchNiche  String?
  searchZone   String?
  countryCode  String?
  createdAt    DateTime @default(now())

  @@map("leads")
}

model ScrapingJob {
  id         Int      @id @default(autoincrement())
  niche      String
  zone       String
  status     String   @default("pending") // pending | running | done | error
  leadsFound Int      @default(0)
  apifyRunId String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("scraping_jobs")
}
