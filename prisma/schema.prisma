generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Lead {
  id           Int          @id @default(autoincrement())
  title        String
  phone        String?
  rating       Float?
  reviewsCount Int?
  category     String?
  address      String?
  city         String?
  website      String?
  mapsUrl      String?
  searchNiche  String?
  searchZone   String?
  countryCode  String?
  jobId        Int?
  job          ScrapingJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@map("leads")
}

model ScrapingJob {
  id         Int      @id @default(autoincrement())
  niche      String
  zone       String
  status     String   @default("pending") // pending | running | done | error
  leadsFound Int      @default(0)
  apifyRunId String?
  error      String?
  leads      Lead[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("scraping_jobs")
}
