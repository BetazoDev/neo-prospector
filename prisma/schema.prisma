generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Singleton marker that proves this database was intentionally initialized.
/// The application refuses to start against a database without this record.
model SystemState {
  key           String   @id
  initializedAt DateTime @default(now())

  @@map("system_state")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  apifyApiKey  String?
  maxLeads     Int           @default(100)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobs         ScrapingJob[]

  @@map("users")
}

model ScrapingJob {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nombre editable de la base (por defecto: "Niche · Zone")
  name       String?
  /// Iniciales para el avatar de la card (2 chars)
  icon       String?  @default("NP")
  /// Color hex del avatar
  color      String?  @default("#7c3aed")
  niche      String
  zone       String
  status     String   @default("pending") // pending | running | importing | done | error
  leadsFound Int      @default(0)
  apifyRunId String?
  /// Dataset de la corrida, para poder recuperar los resultados más tarde.
  apifyDatasetId String?
  /// Secreto que autentica el webhook de Apify para esta base concreta.
  webhookToken   String?
  error      String?
  leads      Lead[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("scraping_jobs")
}

model Lead {
  id           Int          @id @default(autoincrement())
  userId       String
  jobId        Int
  job          ScrapingJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  phone        String?
  rating       Float?
  reviewsCount Int?
  category     String?
  address      String?
  city         String?
  website      String?
  mapsUrl      String?
  searchNiche  String?
  searchZone   String?
  countryCode  String?
  createdAt    DateTime     @default(now())

  @@map("leads")
}
