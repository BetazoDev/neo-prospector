DATABASE_URL="postgresql://app_user:replace-with-a-secret@your-dokploy-postgres-service:5432/postgres?schema=public"
DATABASE_EXPECTED_HOST="your-dokploy-postgres-service"
APIFY_API_KEY="your_apify_api_key_here"
JWT_SECRET="your_jwt_secret_here"
# Public base URL of this app. Optional: when set, Apify calls back the moment a scrape
# finishes instead of waiting for the app to poll. Leave it empty and results are still
# recovered, just on the next dashboard load.
APP_URL="https://prospector.example.com"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
# Set to true only for the one startup that intentionally initializes a new or restored database.
# Remove it immediately after the app reports successful initialization.
ALLOW_DATABASE_INITIALIZATION="false"
