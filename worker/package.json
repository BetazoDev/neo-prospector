{
  "name": "hemeron-demo-worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Worker de la Mac: toma demos de la cola del Prospector, audita, investiga, construye en Astro y publica.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "once": "tsx --env-file=.env src/index.ts --once",
    "check": "tsc --noEmit -p .",
    "probe": "tsx --env-file=.env src/probe.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
