# Prospector al que se conecta el worker
PROSPECTOR_URL=https://prospector.diabolicalservices.tech
# Mismo valor que WORKER_TOKEN en las variables de Dokploy del prospector
WORKER_TOKEN=
# Nombre de este equipo en la pantalla de actividad
WORKER_ID=mac-hemeron

# Claude: token de tu plan, generado con `claude setup-token` (dura un año).
# Si prefieres pagar por uso, deja esto vacío y usa ANTHROPIC_API_KEY con WORKER_AUTH=api-key.
CLAUDE_CODE_OAUTH_TOKEN=
WORKER_AUTH=plan
# ANTHROPIC_API_KEY=

# Demos a la vez
CONCURRENCY=4

# Rutas en esta Mac
CLAUDE_ROOT=/Users/humbertoalonso/Claude
DEMOS_DIR=/Users/humbertoalonso/Claude/prospector-demos
TOOLS_DIR=/Users/humbertoalonso/Claude/lista-2/_tools
PORTAFOLIO_DIR=/Users/humbertoalonso/Claude/portafolio
DEMOS_BASE_URL=https://demos.diabolicalservices.tech

# false: audita, investiga y construye, pero no hace push al repositorio de demos
PUBLISH=true

# Opcionales
# Primer puerto para los servidores de Astro de cada demo en paralelo (usa dos por lugar)
# BASE_PORT=4600
# Cada cuánto pide trabajo al prospector, en milisegundos
# POLL_MS=15000
# true: corre a los agentes dentro del sandbox de Claude Code (solo escriben en sus carpetas)
# WORKER_SANDBOX=false
